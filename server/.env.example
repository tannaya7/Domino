# Copy this file to server/.env and fill in real values there — server/.env is git-ignored and is
# loaded automatically by `npm run server:dev` (see server/src/localServer.ts). Never commit real
# values, and never paste them into a chat/terminal that gets logged.

# GitHub personal access token (fine-grained, "Public repositories (read-only)", no other
# permissions) — raises the GitHub API quota from 60 req/hour (unauthenticated) to 5,000 req/hour.
# Falls back to `gh auth token`, then unauthenticated, when unset.
GITHUB_TOKEN=

# Enables real Bedrock-generated risk narratives/runbooks — a deterministic generator is used when
# this is unset.
BEDROCK_MODEL_ID=

# AWS region for Bedrock/DynamoDB/Health/SNS — defaults to us-east-1 when unset.
AWS_REGION=

# Real graph cache in DynamoDB — falls back to an in-memory cache (this process only) when unset.
DYNAMODB_GRAPH_CACHE_TABLE=

# Real AWS Health describeEvents (needs a Business/Enterprise support plan) — falls back to the
# public AWS status feed, then "unknown", when unset or failing.
AWS_HEALTH_ENABLED=

# Vendor-degradation alerts published to SNS — a no-op when unset.
SNS_ALERT_TOPIC_ARN=
