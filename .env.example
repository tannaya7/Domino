# Copy this file to .env (or .env.local) at the repo root for the FRONTEND build — Vite loads it
# automatically. This is a separate, smaller set of vars than server/.env.example (the backend's).

# Base URL the frontend calls for every API request (src/lib/api.ts) — baked in at BUILD time,
# not read at runtime, so changing this requires a rebuild (`npm run build`), not just a restart.
# Defaults to http://localhost:8787 when unset, which is correct for local dev
# (`npm run server:dev`) and needs no .env file at all. Only set this to point a built frontend at
# a different backend — e.g. a deployed API Gateway URL, or a public tunnel URL for a live demo
# (see scripts/live-demo-watchdog.sh).
VITE_API_BASE_URL=
